# ─────────────────────────────────────────────
# SELENA FITNESS — Environment Variables
# Copy to .env.local (local dev) or set in Vercel
# project settings (Settings → Environment Variables).
#
# Get a free Formspree form ID:
#   1. Go to https://formspree.io and create an account
#   2. Create a new form (or use the admin-generated one)
#   3. The form endpoint will look like:
#        https://formspree.io/f/YOUR_FORM_ID
#   4. Paste YOUR_FORM_ID below (e.g. "xbjvqlzg")
# ─────────────────────────────────────────────

# Booking requests (homepage Booking section + /booking page)
NEXT_PUBLIC_FORMSPREE_BOOKING_ID=

# General contact messages (/contact page)
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=
